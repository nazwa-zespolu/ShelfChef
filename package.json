{
  "name": "mdstudy",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "node -e \"const {spawnSync} = require('node:child_process'); let failed = false; for (const suite of ['test:logic', 'test:ui']) { const result = spawnSync(process.execPath, [process.env.npm_execpath, 'run', suite, '--', ...process.argv.slice(1)], {stdio: 'inherit'}); if (result.error) console.error(result.error); if (result.status !== 0) failed = true; } process.exitCode = failed ? 1 : 0;\" --",
    "test:logic": "node --experimental-sqlite node_modules/jest/bin/jest.js --runInBand --coverageDirectory=src/coverage/logic",
    "test:ui": "npm --prefix src test -- --runInBand --coverageDirectory=coverage/ui",
    "test:watch": "npm run test:logic -- --watch",
    "test:watch:ui": "npm run test:ui -- --watch",
    "test:coverage": "npm test -- --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nazwa-zespolu/MDstudy.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nazwa-zespolu/MDstudy/issues"
  },
  "homepage": "https://github.com/nazwa-zespolu/MDstudy#readme",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.2"
  }
}
