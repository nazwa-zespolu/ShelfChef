{
  "expo": {
    "name": "ShelfChef",
    "slug": "shelfchef",
    "version": "1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.shelfchef",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Aplikacja używa biblioteki zdjęć, aby dodać zdjęcie produktu do katalogu."
      }
    },
    "android": {
      "package": "com.shelfchef",
      "versionCode": 1,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Aplikacja używa aparatu do skanowania kodów i dodawania zdjęć produktów.",
          "enableMicrophonePermission": false,
          "enableLocation": false,
          "enableCodeScanner": true
        }
      ],
      "./plugins/withShelfChefAndroidManifest"
    ]
  }
}
